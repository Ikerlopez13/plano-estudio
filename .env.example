# Plantilla de variables de entorno de Plano Estudio.
# Copia este archivo a .env.local (o .env) y rellena los valores.
# NUNCA subas .env ni .env.local al repositorio: solo esta plantilla.

# Clave de OpenAI (opcional). Si la pones, el modo «IA conectada» funciona sin
# que el usuario introduzca su propia clave. Tiene coste de uso.
OPENAI_API_KEY=

# Contraseña de acceso a la app. Si está vacía, la app NO pide login (modo local).
# Ponla SIEMPRE antes de desplegar en internet.
PLANO_PASSWORD=

# Puerto. En local por defecto 8765. En despliegue, muchos hosts definen PORT solos.
PLANO_PORT=8765

# Dirección de escucha. En local 127.0.0.1. Para desplegar usa 0.0.0.0.
PLANO_BIND=127.0.0.1

# Hosts públicos permitidos al desplegar, separados por comas (p. ej. tu-app.onrender.com).
# Usa * para permitir cualquiera (seguro porque la contraseña protege el acceso).
PLANO_ALLOWED_HOSTS=
